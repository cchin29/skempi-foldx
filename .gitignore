__pycache__/
*.py[cod]
.venv*/
*.egg-info/
build/
dist/
.pytest_cache/
.DS_Store

# FoldX working directories: gigabytes of .fxout/.pdb intermediates. Regenerable --
# but NOT before list_hashes.py has run, because individual_list.txt lives here and it is
# the only record of what BuildModel actually consumed. See docs/DETERMINISM.md.
# FoldX itself is never redistributable, and neither is its licensed support data. A contributor
# working outside the default directories should not be able to commit any of it by accident.
foldx
foldx_*
foldx[0-9]*
foldxLinux*
foldxMac*
foldx*/
rotabase.txt
molecules/
*.fxout
*_Repair.pdb
*_Repair_*.pdb
WT_*.pdb
repair_round_*.pdb
individual_list.txt
.env

scratch/
work/
work_*/

# Generated on demand by the --html flag of compare_versions.py and store_composition.py.
# The version comparison's page is ~5 MB; both are self-contained and reproduce from the repo.
docs/assets/*.html

# Generated on demand by --csv. version_compare.csv is deliberately not shipped: its
# ddg_experimental column is per-row SKEMPI affinity data, and this repo does not redistribute
# skempi_v2.csv. store_composition.csv carries no SKEMPI data and is merely regenerable.
docs/assets/*.csv
